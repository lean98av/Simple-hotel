<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Iniciar Sesión - ShopMaster</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin/admin-theme.css">
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href="/">ShopMaster</a>
      <div>
        <a href="/" class="btn btn-light">Volver al home</a>
      </div>
    </div>
  </nav>

  <!-- Login Form -->
  <div class="container mt-5 mb-5">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-4">
        <div class="card shadow-lg p-4">
          <div class="text-center mb-4">
            <h1 class="mb-3">🔐 Panel de Administración</h1>
            <p class="text-muted">Inicia sesión para continuar</p>
          </div>

          <form id="loginForm" method="POST" class="mb-4">
            <% if (typeof error !== 'undefined' && error) { %>
              <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
              </div>
            <% } %>

            <div class="mb-3">
              <label for="adminUser" class="form-label">
                <i class="bi bi-person me-2"></i>Usuario
              </label>
              <input
                type="text"
                class="form-control"
                id="adminUser"
                name="user"
                required
                autofocus
                autocomplete="username"
                placeholder="tu-usuario"
              >
            </div>


            <div class="mb-3">
              <label for="adminPass" class="form-label">
                <i class="bi bi-key me-2"></i>Contraseña
              </label>
              <input
                type="password"
                class="form-control"
                id="adminPass"
                name="pass"
                required
                autocomplete="current-password"
              >
            </div>

            <div class="d-grid">
              <button type="submit" class="btn btn-primary btn-lg">
                <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar Sesión
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer class="bg-dark text-white py-3 mt-5">
    <div class="container text-center">
      <p class="mb-0">&copy; 2026 ShopMaster. Panel de Administración.</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const form = document.getElementById('loginForm');
      const userInput = document.getElementById('adminUser');
      const passInput = document.getElementById('adminPass');

      // Check if already authenticated
      // const storedAuth = localStorage.getItem('adminAuth');
      // if (storedAuth) {
      //   sessionStorage.setItem('adminAuthenticated', 'true');
      //   window.location.href = '/admin';
      // }

      form.addEventListener('submit', function(e) {
        const user = userInput.value;
        const pass = passInput.value;

        // Prevent default submission - we'll send via AJAX
        e.preventDefault();

        fetch('/admin/login', {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ user, pass }),
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            // Cookie is set by server (httpOnly). Redirect to admin dashboard.
            window.location.href = '/admin/home';
          } else {
            // Return to form with error message
            window.location.reload();
          }
        })
        .catch(error => {
          console.error('Login error:', error);
          window.location.reload();
        });
      });

      // Check for redirect errors from query params
      const searchParams = new URLSearchParams(window.location.search);
      const error = searchParams.get('error');
      if (error === 'access_denied' || error === 'logout') {
        userInput.value = '';
        passInput.value = '';
        userInput.focus();
      }
    });
  </script>
</body>
</html>
