<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%- title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin/admin-theme.css">
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href="/">ShopMaster</a>
    </div>
  </nav>

  <!-- Admin Panel -->
  <div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1><%- title %></h1>
      <button class="btn btn-secondary" onclick="goToProducts()">
        ← Volver
      </button>
    </div>

    <div class="row justify-content-center">
      <div class="col-md-8">
        <div class="card shadow">
          <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><%= title.includes('Create') ? 'Crear Producto' : 'Editar Producto' %></h4>
          </div>
          <div class="card-body">
            <form id="productForm">
              <div class="mb-3">
                <label for="productName" class="form-label">Nombre *</label>
                <input type="text" class="form-control" id="productName" required>
                <div class="invalid-feedback">
                  El nombre es requerido
                </div>
              </div>

              <div class="mb-3">
                <label for="productPrice" class="form-label">Precio *</label>
                <input type="number" step="0.01" class="form-control" id="productPrice" required>
                <div class="invalid-feedback">
                  El precio es requerido
                </div>
              </div>

              <div class="mb-3">
                <label for="image1" class="form-label">Imagen 1</label>
                <input type="file" name="images" class="form-control" id="image1" accept="image/*">
                <div class="form-text">
                  Soporta imágenes JPG, PNG, GIF. Máximo 2MB.
                </div>
                <div id="imagePreview1" class="mt-2" style="display: none;">
                  <img id="imagePreviewImg1" src="" alt="Vista previa" style="max-height: 200px;">
                </div>
              </div>
              <div class="mb-3">
                <label for="image2" class="form-label">Imagen 2</label>
                <input type="file" name="images" class="form-control" id="image2" accept="image/*">
                <div class="form-text">
                  Soporta imágenes JPG, PNG, GIF. Máximo 2MB.
                </div>
                <div id="imagePreview2" class="mt-2" style="display: none;">
                  <img id="imagePreviewImg2" src="" alt="Vista previa" style="max-height: 200px;">
                </div>
              </div>
              <div class="mb-3">
                <label for="image3" class="form-label">Imagen 3</label>
                <input type="file" name="images" class="form-control" id="image3" accept="image/*">
                <div class="form-text">
                  Soporta imágenes JPG, PNG, GIF. Máximo 2MB.
                </div>
                <div id="imagePreview3" class="mt-2" style="display: none;">
                  <img id="imagePreviewImg3" src="" alt="Vista previa" style="max-height: 200px;">
                </div>
              </div>
              <div class="mb-3">
                <label for="image4" class="form-label">Imagen 4</label>
                <input type="file" name="images" class="form-control" id="image4" accept="image/*">
                <div class="form-text">
                  Soporta imágenes JPG, PNG, GIF. Máximo 2MB.
                </div>
                <div id="imagePreview4" class="mt-2" style="display: none;">
                  <img id="imagePreviewImg4" src="" alt="Vista previa" style="max-height: 200px;">
                </div>
              </div>

              <div class="mb-3">
                <label for="productCategoryId" class="form-label">Categoría *</label>
                <select class="form-select" id="productCategoryId" required>
                  <option value="">Selecciona una categoría</option>
                </select>
                <div class="invalid-feedback">
                  La categoría es requerida
                </div>
              </div>

              <div class="mb-3">
                <label for="productDescription" class="form-label">Descripción</label>
                <textarea class="form-control" id="productDescription" rows="3"></textarea>
              </div>

              <div class="mb-3 form-check">
                <input type="checkbox" class="form-check-input" id="showToClients" checked value="true">
                <label class="form-check-label" for="showToClients">
                  Mostrar al cliente
                </label>
              </div>

              <div class="mb-3 form-check">
                <input type="checkbox" class="form-check-input" id="outStock" checked value="true">
                <label class="form-check-label" for="outStock">
                  Sin Stock
                </label>
              </div>

              <div class="mb-3 form-check">
                <input type="checkbox" class="form-check-input" id="topProduct" checked value="true">
                <label class="form-check-label" for="topProduct">
                  Añadir a producto destacado
                </label>
              </div>
              <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">
                  <%= title.includes('Create') ? 'Crear Producto' : 'Actualizar Producto' %>
                </button>
                <button onclick="goToProducts()" class="btn btn-secondary">
                  ← Volver
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Success Modal -->
<div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content rounded-3">
      <div class="modal-header">
        <h5 class="modal-title text-success">¡Éxito!</h5>
      </div>
      <div class="modal-body">
        <p id="successMessage" class="text-center">Producto creado exitosamente</p>
      </div>
      <div class="modal-footer justify-content-center">
        <button id="backBtn" class="btn btn-secondary">Ir a productos</button>
        <button id="continueBtn" class="btn btn-primary">Crear otro producto</button>
      </div>
    </div>
  </div>
</div>


  <!-- Footer -->
  <footer class="bg-dark text-white py-4 mt-5">
    <div class="container text-center">
      <p class="mb-0">&copy; 2026 ShopMaster. Panel de Administración.</p>
    </div>
  </footer>

  <script>
    window.createEditProductData = {
      title: <%- JSON.stringify(title) %>,
      categories: <%- JSON.stringify(categories) %>,
      product: <%- JSON.stringify(product || null) %>,
    };

    // No legacy 'pass' usage. Navigate normally; auth is via cookie.
    function goToProducts() {
      window.location.href = '/admin/products';
    }
  </script>
<script src="/js/createEditProduct/createEditProduct.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
