<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%- title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin/admin-theme.css">
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href="/">ShopMaster</a>
    </div>
  </nav>

  <!-- Admin Panel -->
  <div class="container mt-5">
    <div class="row justify-content-center">
      <div class="col-md-8">
        <div class="text-center">
          <h1 class="mb-4">👋 Bienvenido al Panel de Administración</h1>
          <p class="lead mb-5">Selecciona una opción para comenzar</p>
           <div class="row row-cols-1 row-cols-md-2 g-3 admin-home-buttons">
            <div class="col">
              <a href="/admin/products" class="btn btn-primary w-100">
                📦 Ver Productos
              </a>
            </div>
            <div class="col">
              <a href="/admin/orders" class="btn btn-success w-100">
                🛒 Ver Órdenes
              </a>
            </div>
            <div class="col">
              <a href="/admin/categories" class="btn btn-info w-100">
                🏷️ Ver Categorías
              </a>
            </div>
            <div class="col">
              <a href="/admin/announcements" class="btn btn-warning w-100">
                📢 Ver Anuncios
              </a>
            </div>
            <div class="col">
              <a href="/admin/settings" class="btn btn-danger w-100">
                ⚙️ Configuraciones
              </a>
            </div>
            <div class="col">
              <button class="btn btn-secondary w-100" onclick="logoutAdmin()">
                🚪 Cerrar Sesión
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

   

  <!-- Footer -->
  <footer class="bg-dark text-white py-4 mt-5">
    <div class="container text-center">
      <p class="mb-0">&copy; 2026 ShopMaster. Panel de Administración.</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    const buttons = document.querySelectorAll('a[href^="/admin/products"], a[href^="/admin/orders"], a[href^="/admin/settings"]');
    buttons.forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const route = this.getAttribute('href');
        window.location.href = route;
      });
    });

     function logoutAdmin() {
      // Call server logout which clears cookie and redirects
      window.location.href = '/admin/login/logout';
    }

  </script>
</body>
</html>
