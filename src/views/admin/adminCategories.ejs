<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%- title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin/admin-theme.css">
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href="/">ShopMaster</a>
    </div>
  </nav>

  <!-- Admin Panel -->
  <div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1><%- title %></h1>
      <button class="btn btn-secondary" onclick="goToAdmin()">
        ← Volver al Admin
      </button>
    </div>

    <!-- Fila con botón -->
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div></div>
      <div>
        <button onclick="goToCreate()" class="btn btn-primary">
          ➕ Crear Categoría
        </button>
      </div>
    </div>
  </div>

  <% function getImageMimeType(filename) {
       const ext = filename?.split('.').pop()?.toLowerCase();
       const types = {
         jpg: 'image/jpeg',
         jpeg: 'image/jpeg',
         png: 'image/png',
         gif: 'image/gif',
         webp: 'image/webp',
       };
       return types[ext] || 'image/jpeg';
     }
  %>

  <!-- Category List -->
  <div class="container mt-4">
    <% if (categories.length === 0) { %>
      <div class="alert alert-info">No se encontraron categorías.</div>
    <% } else { %>
      <div class="row">
        <% categories.forEach(category => { %>
          <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100 shadow-sm">
              <div class="card-body">
                <% if (category.images && category.images.length > 0) { %>
                  <img src="data:<%= getImageMimeType(category.images[0].name) %>;base64,<%= category.images[0].file %>"
                      alt="<%= category.name %> Imagen 1"
                      class="img-fluid rounded" style="max-height: 200px; object-fit: cover;">
                <% } %>
                <h5 class="card-title"><%= category.name %></h5>
                <% if (category.description) { %>
                  <p class="card-text text-muted"><strong>Descripción:</strong> <%= category.description %></p>
                <% } %>
                <p class="card-text">
                  <small class="text-muted">ID: <%= category.id %></small>
                </p>
                <div class="d-flex gap-2">
                  <button onclick="editCategory(<%= category.id %>)" class="btn btn-sm btn-warning">
                    ✏️ Editar
                  </button>
                    <% if (category.id != 1) { %>
                      <button onclick="deleteCategory(<%= category.id %>)" class="btn btn-sm btn-danger">
                        🗑️ Eliminar
                      </button>
                    <% } %>
                
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/modal.js"></script>
  <script>
    // Authentication uses cookie (adminToken). No client-side stored password.

    window.adminCategoriesData = {
      categories: <%- JSON.stringify(categories) %>,
    };

    function goToAdmin() {
      window.location.href = '/admin';
    }

    function goToCreate() {
      window.location.href = '/admin/categories/create';
    }

    async function deleteCategory(id) {
      // Mostrar modal de confirmación
      showConfirmModal('¿Eliminar categoría?', '¿Estás seguro de que deseas eliminar esta categoría? Esta acción no se puede deshacer.', () => {
        deleteCategoryConfirmed(id);
      });
    }

    function deleteCategoryConfirmed(id) {
      try {
        const response = fetch('/admin/categories/' + id, {
          method: 'DELETE',
          credentials: 'same-origin',
          headers: {
            'Content-Type': 'application/json',
          },
        });

        response.then(async (res) => {
          const data = await res.json();

          if (res.ok && data.success) {
            showModal('Categoría eliminada correctamente', '', false);
            window.location.reload();
          } else {
            showModal('Error al eliminar categoría', data.message || '', false);
          }
        });
      } catch (err) {
        showModal('Error al eliminar categoría', '', false);
      }
    }

    function editCategory(id) {
      window.location.href = '/admin/categories/' + id + '/edit';
    }
  </script>

  <%- include('partials/globalModal') %>
</body>
</html>
