<!DOCTYPE html>
<html lang="es">

<head>

  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>
    Pedido confirmado
  </title>

  <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Montserrat:wght@400;500;600;700&display=swap"
    rel="stylesheet">

  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">

  <style>
    body {
      background:
        linear-gradient(180deg,
          #fff 0%,
          #faf6fb 100%);
    }

    .success-wrapper {
      max-width: 950px;
      margin: auto;
    }

    .success-card {
      border: none;
      border-radius: 32px;
      overflow: hidden;
      background: white;
      box-shadow:
        0 10px 40px rgba(0, 0, 0, 0.08);
    }

    .success-header {
      background:
        linear-gradient(135deg,
          #f6dff0 0%,
          #ead7ff 100%);

      padding: 50px 30px;
      text-align: center;
    }

    .success-icon {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      background: white;

      display: flex;
      align-items: center;
      justify-content: center;

      margin: auto auto 20px;

      font-size: 2.4rem;
      color: #25D366;

      box-shadow:
        0 10px 25px rgba(0, 0, 0, 0.08);
    }

    .success-title {
      font-weight: 700;
      margin-bottom: 10px;
    }

    .success-subtitle {
      color: #666;
      margin-bottom: 0;
    }

    .content-area {
      padding: 40px 30px;
    }

    .summary-card {
      border-radius: 24px;
      background: #fafafa;
      padding: 25px;
      border: 1px solid #eee;
    }

    .summary-item {
      display: flex;
      justify-content: space-between;
      margin-bottom: 14px;
      color: #555;
    }

    .summary-total {
      border-top: 1px solid #ddd;
      padding-top: 16px;
      margin-top: 16px;

      font-size: 1.2rem;
      font-weight: 700;
      color: #111;
    }

    .payment-card {
      border-radius: 24px;
      background:
        linear-gradient(135deg,
          #fff0f7 0%,
          #f7f2ff 100%);

      padding: 25px;
      margin-top: 25px;
    }

    .payment-title {
      font-weight: 700;
      margin-bottom: 20px;
    }

    .payment-box {
      background: white;
      border-radius: 18px;
      padding: 18px;
      margin-bottom: 14px;
      border: 1px solid #eee;
    }

    .payment-label {
      font-size: .85rem;
      color: #888;
      margin-bottom: 6px;
    }

    .payment-value {
      font-weight: 700;
      color: #222;
    }

    .whatsapp-btn {
      margin-top: 30px;
      height: 62px;
      border-radius: 18px;
      border: none;

      background: #25D366;
      color: white;

      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;

      text-decoration: none;

      font-weight: 600;
      font-size: 1rem;

      transition: .25s ease;
    }

    .whatsapp-btn:hover {
      background: #1ebe5b;
      color: white;
      transform: translateY(-2px);
    }

    @media(max-width: 768px) {

      .content-area {
        padding: 30px 20px;
      }

      .success-header {
        padding: 40px 20px;
      }

    }

    .copy-btn {

      border: none;

      width: 42px;

      height: 42px;

      border-radius: 50%;

      background:
        linear-gradient(135deg,
          #f6dff0 0%,
          #ead7ff 100%);

      color: #444;

      transition: .25s ease;

      display: flex;

      align-items: center;

      justify-content: center;

    }

    .copy-btn:hover {

      transform: scale(1.06);

      color: #111;

      box-shadow:
        0 6px 18px rgba(0, 0, 0, 0.08);

    }

    @media (min-width: 992px) {

      .success-wrapper {
        max-width: 780px;
      }

      .success-header {
        padding: 35px 25px;
      }

      .success-icon {
        width: 72px;
        height: 72px;
        font-size: 2rem;
        margin-bottom: 15px;
      }

      .success-title {
        font-size: 2rem;
      }

      .success-subtitle {
        font-size: .95rem;
      }

      .content-area {
        padding: 30px 25px;
      }

      .summary-card,
      .payment-card {
        padding: 20px;
        border-radius: 20px;
      }

      .payment-box {
        padding: 14px;
        border-radius: 14px;
      }

      .payment-value {
        font-size: .95rem;
      }

      .whatsapp-btn {
        height: 54px;
        font-size: .95rem;
        border-radius: 14px;
        margin-top: 22px;
      }

    }
  </style>

</head>

<body>

  <%- include('partials/topbar') %>
    <div class="container mt-4 pt-5"></div>
    <div class="container py-5">

      <div class="success-wrapper">

        <div class="success-card">

          <!-- HEADER -->

          <div class="success-header">

            <div class="success-icon">

              <i class="fas fa-check"></i>

            </div>

            <h1 class="success-title">

              ¡Pedido confirmado!

            </h1>

            <p class="success-subtitle">

              Tu orden fue generada correctamente

            </p>

          </div>

          <!-- CONTENT -->

          <div class="content-area">

            <!-- RESUMEN -->

            <div class="summary-card" id="summaryCard"></div>

            <!-- DATOS DE PAGO -->

            <div class="payment-card">

              <h4 class="payment-title">

                Datos para transferencia

              </h4>

              <!-- ALIAS -->

              <div class="payment-box">

                <div class="d-flex justify-content-between align-items-center">

                  <div>

                    <div class="payment-label">
                      Alias
                    </div>

                    <div class="payment-value" id="aliasText">
                      <%= appSettings.alias %>
                    </div>

                  </div>

                  <!-- <button type="button" class="copy-btn" onclick="copyText('aliasText')">

                    <i class="fas fa-copy"></i>

                  </button> -->

                </div>

              </div>

              <!-- CBU -->

              <div class="payment-box">

                <div class="d-flex justify-content-between align-items-center">

                  <div>

                    <div class="payment-label">
                      CBU
                    </div>

                    <div class="payment-value" id="cbuText">
                      <%= appSettings.cbu %>
                    </div>

                  </div>
                  <!--
                  <button type="button" class="copy-btn" onclick="copyText('cbuText')">

                    <i class="fas fa-copy"></i>

                  </button> -->

                </div>

              </div>

            </div>
            <div class="shipping-card mt-4">

              <div class="shipping-header">

                <div class="shipping-icon">

                  <i class="fas fa-truck"></i>

                </div>

                <h5 class="shipping-title">

                  Información de envíos

                </h5>

              </div>

              <div class="shipping-item">

                <i class="fas fa-motorcycle"></i>

                <span>
                  Envíos a domicilio por Uber Moto
                  <small>(costo aparte)</small>
                </span>

              </div>

              <div class="shipping-item">

                <i class="fas fa-box"></i>

                <span>
                  Envíos al interior de la provincia por Balut Express
                  <small>(costo aparte)</small>
                </span>

              </div>

              <div class="shipping-item">

                <i class="fas fa-map-marked-alt"></i>

                <span>
                  Envíos a todo el país por Correo Argentino
                  <small>(costo aparte)</small>
                </span>

              </div>

            </div>
          </div>
          <!-- WHATSAPP -->


          <a id="whatsappBtn" target="_blank" class="whatsapp-btn">

            <i class="fab fa-whatsapp"></i>

            Consultar envio
          </a>

        </div>

      </div>

    </div>

    </div>

    <%- include('partials/footer') %>

      <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
      <script src="/js/modal.js"></script>
      <script>
        function showModal(title, message, showCancel = true) {
          // Esperar a que Bootstrap esté cargado
          if (!bootstrapLoaded) {
            const checkBootstrap = setInterval(() => {
              if (typeof bootstrap !== 'undefined') {
                clearInterval(checkBootstrap);
                bootstrapLoaded = true;
                showModalInternal(title, message, showCancel);
              }
            }, 100);
            return;
          }
          
          showModalInternal(title, message, showCancel);
        }

        function showModalInternal(title, message, showCancel) {
          const modalElement = document.getElementById('globalModal');
          
          if (!modalElement) {
            console.warn('Modal no encontrado. Asegúrate de incluir el modal HTML en la vista.');
            return;
          }
          
          // Actualizar el contenido del modal
          modalElement.querySelector('.modal-title').textContent = title;
          modalElement.querySelector('.modal-body').innerHTML = message;
          modalElement.dataset.showCancel = showCancel;
          
          // Mostrar el modal
          const modal = new bootstrap.Modal(modalElement);
          modal.show();
        }

        async function copyText(id) {

          const text =
            document.getElementById(id).textContent.trim();

          try {

            await navigator.clipboard.writeText(text);

            const toastElement =
              document.getElementById('copyToast');

            const toast =
              new bootstrap.Toast(toastElement);

            toast.show();

          } catch (err) {

            console.error(err);

            showModal('No se pudo copiar', '', false);

          }

        }

      </script>

      <script>

        const order =
          JSON.parse(
            localStorage.getItem('lastOrder')
          );

        if (!order) {

          window.location.href = '/';

        }

        document.getElementById('summaryCard').innerHTML = `

    <h4 class="mb-4 fw-bold">
        Resumen de compra
    </h4>

    <div class="summary-item">
        <span>Número de orden</span>
        <strong>#${order.id}</strong>
    </div>

    <div class="summary-item">
        <span>Cliente</span>
        <strong>${order.clientName}</strong>
    </div>

    <div class="summary-item">
        <span>Teléfono</span>
        <strong>${order.clientPhone}</strong>
    </div>

    <div class="summary-item">
        <span>Dirección</span>
        <strong>${order.address}</strong>
    </div>

    ${order.cart.map(item => `

        <div class="summary-item">

            <span>
                ${item.name} x${item.quantity}
            </span>

            <strong>
                $${Number(item.price * item.quantity).toLocaleString('es-ES', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}
            </strong>

        </div>

    `).join('')}

    <div class="summary-item summary-total">

        <span>
            Total (no incluye envíos)
        </span>

        <span>
            $${Number(order.total).toLocaleString('es-ES', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}
        </span>

    </div>

`;

        const cartText =
          order.cart.map(item =>

            `- ${item.name} x${item.quantity} ($${Number(item.price * item.quantity).toLocaleString('es-ES', { minimumFractionDigits: 0, maximumFractionDigits: 0 })})`

          ).join('\n');

        const whatsappText =
          `Hola, realicé un pedido en ShopMaster.

Número de orden: #${order.id}
Cliente: ${order.clientName}
Teléfono: ${order.clientPhone}
Dirección: ${order.address}

Productos:
${cartText}

Total: $${Number(order.total).toLocaleString('es-ES', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}

Quisiera coordinar el envío.`;

        document.getElementById('whatsappBtn').href =

          `https://wa.me/<%= appSettings.whatsapp %>?text=${encodeURIComponent(whatsappText)}`;

      </script>

  <%- include('partials/globalModal') %>
</body>

</html>
