<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShopMaster - Mi Carrito</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Montserrat:wght@400;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/tokens.css">
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/detail.css">
</head>

<% function getImageMimeType(filename) { const ext=filename?.split('.').pop()?.toLowerCase(); const types={
    jpg: 'image/jpeg' , jpeg: 'image/jpeg' , png: 'image/png' , gif: 'image/gif' , webp: 'image/webp' , }; return
    types[ext] || 'image/jpeg' ; } %>

    <body>
        <%- include('partials/topbar') %>
            <div class="container mt-4 pt-5">

                <div class="container py-5">

                    <h1 class="mb-4">
                        🛒 Mi carrito
                    </h1>

                    <div id="cart-container"></div>

                </div>

            </div>


            <%- include('partials/footer') %>
                <script>

                    function getCart() {
                        return JSON.parse(localStorage.getItem('cart')) || [];
                    }

                    function saveCart(cart) {
                        localStorage.setItem('cart', JSON.stringify(cart));
                    }

                    function removeProduct(id) {

                        let cart = getCart();

                        cart = cart.filter(x => x.id != id);

                        saveCart(cart);
                        updateTopBar();

                        renderCart();
                    }

                    function updateQuantity(id, quantity) {

                        const cart = getCart();

                        const item = cart.find(x => x.id == id);

                        if (!item) return;

                        item.quantity = Math.max(1, quantity);

                        saveCart(cart);
                        updateTopBar();

                        renderCart();
                    }

                    function renderCart() {

                        const cart = getCart();

                        const container = document.getElementById('cart-container');

                        if (!cart.length) {

                            container.innerHTML = `
            <div class="alert alert-info">
                Tu carrito está vacío
            </div>
        `;

                            return;
                        }

                        let total = 0;

                        let html = `
        <div class="row">
            <div class="col-lg-8">
    `;

                        cart.forEach(item => {

                            const subtotal = item.price * item.quantity;

                            total += subtotal;

                            const image = item.image?.file
                                ? `data:image/jpeg;base64,${item.image.file}`
                                : '/images/logo.png';

                            html += `

        <div class="card mb-3 border-0 shadow-sm rounded-4">

            <div class="card-body d-flex align-items-center gap-3">

                <img src="${image}"
                    style="
                        width:90px;
                        height:90px;
                        object-fit:cover;
                        border-radius:18px;
                    ">

                <div class="flex-grow-1">

                    <h5>${item.name}</h5>
                    <span class="small text-muted">
                            Cantidad:
                        </span>
                    <div class="d-flex align-items-center gap-2 mt-2">

                       

                        
                        <button
                            class="btn btn-light border rounded-circle"
                            onclick="updateQuantity(${item.id}, ${item.quantity - 1})"
                            ${item.quantity <= 1 ? 'disabled' : ''}
                            style="width:32px;height:32px;padding:0;">
                            -
                        </button>

                        <strong>
                            ${item.quantity}
                        </strong>
                        <button
                            class="btn btn-light border rounded-circle"
                            onclick="updateQuantity(${item.id}, ${item.quantity + 1})"
                            style="width:32px;height:32px;padding:0;">
                            +
                        </button>

                    </div>

                    <div class="text-primary fw-bold mt-2">
                        Precio unitario: $${Number(item.price).toLocaleString('es-ES', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}
                    </div>

                    <div class="fw-semibold mt-1">
                        Subtotal: $${Number(subtotal).toLocaleString('es-ES', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}
                    </div>

                </div>

                <button
                    class="btn btn-danger rounded-pill"
                    onclick="removeProduct(${item.id})">
                    ✕
                </button>

            </div>

        </div>

        `;
                        });

                        html += `
            </div>

            <div class="col-lg-4">

                <div class="cart-summary-card">

                    <div class="cart-summary-header">

                        <span class="summary-label">
                            Resumen del pedido
                        </span>

                        <h2>
                            $${Number(total).toLocaleString('es-ES', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}
                        </h2>

                    </div>

                    <div class="cart-summary-divider"></div>

                    <a href="/" class="cart-secondary-btn">
                        Continuar comprando
                    </a>

                    <a href="/checkout" class="btn btn-primary w-100">
                        Completa tus datos
                    </a>

                </div>

            </div>

        </div>
    `;

                        container.innerHTML = html;
                    }

                    renderCart();

                </script>
                <script
                    src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    </body>

</html>