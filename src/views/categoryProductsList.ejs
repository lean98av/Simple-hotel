<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Montserrat:wght@400;600;700&display=swap"
  rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/home.css">
</head>
<body>
  <div class="container mt-4 pt-5"></div>
  <%- include('partials/topbar') %>
      <section class=" text-center text-dark">
        <div class="container">
            <h1 class="mt-5"> <%= categoryData.name %></h1>
        </div>
    </section>
  <div class="container mt-4 pt-5">
    <%- include('partials/filters') %>
    <!-- GRID DE PRODUCTOS -->
    <div id="productsGrid" class="row g-4 mb-5" data-category-id="<%= categoryData.id %>" data-current-page="<%= page || 1 %>">
      <% if(products && products.length > 0) { %>
        <% products.forEach(product => { %>
          <div class="col-6 col-md-4 col-lg-3">
            <%- include('partials/productCard', { product }) %>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12">
          <div class="alert alert-light text-center">No hay productos disponibles</div>
        </div>
      <% } %>
    </div>
    
        <!-- Trigger para scroll infinito y loading indicator -->
        <div id="scrollTrigger" style="width:100%;height:1px;"></div>
        <div id="loadingIndicator" class="text-center my-4" style="display:none;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
  </div>

  <%- include('partials/footer') %>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
  <script src="/js/categoryProductsList.js"></script>
  <script>
   const categoryId = <%= categoryData.id %>
    document.addEventListener('DOMContentLoaded', () => {
      try { window.initScrollInfiniteProducts(); } catch(e) { console.error(e); }
    });
  </script>
</body>
</html>
